{
	"compilerOptions": {
		"target": "es2023",
		"module": "es2022",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./javascript",
		"rootDir": "./src",
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "javascript"]
}
